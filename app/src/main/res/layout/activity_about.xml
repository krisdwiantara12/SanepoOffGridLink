<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_console"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/btnAboutBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_keycap_btn"
            android:contentDescription="@string/desc_back"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/ink_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Tentang &amp; Pembaruan Aplikasi"
            android:textColor="@color/ink_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Brand Identity Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_console"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Sanepo OffGrid Link"
                    android:textColor="@color/ink_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAboutVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="Versi 1.0.0 (Build 1)"
                    android:textColor="@color/accent_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Walkie-Talkie PTT suara real-time, chat offline, radar jarak dan kompas GNSS antar perangkat tanpa kuota internet, pulsa, atau router eksternal."
                    android:textColor="@color/ink_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Auto OTA Update Console -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_console_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_cloud_update"
                        app:tint="@color/accent_ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Cek Update Aplikasi (GitHub OTA)"
                        android:textColor="@color/ink_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUpdateStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tekan tombol di bawah saat ada koneksi internet untuk memeriksa rilis terbaru."
                    android:textColor="@color/ink_secondary"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressUpdateCheck"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCheckUpdate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_accent_btn"
                        android:minHeight="48dp"
                        android:text="Cek Update"
                        android:textColor="@color/ink_on_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnInstallUpdate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_keycap_btn"
                        android:minHeight="48dp"
                        android:text="Unduh &amp; Pasang"
                        android:textColor="@color/ink_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbAutoCheckUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="48dp"
                    android:text="Cek update otomatis setiap 6 jam saat dibuka"
                    android:textColor="@color/ink_primary"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbIncludePreRelease"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Sertakan versi prarilis (beta / RC)"
                    android:textColor="@color/ink_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Technical Notes & Developer Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_console_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengembang &amp; Asal Proyek"
                    android:textColor="@color/ink_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Developer: Kris Dwi Antara dan Tim Sanepo Team\nTransport: Wi-Fi Direct P2P (TCP 47880, UDP 47881/47882), Hotspot LAN Offline, BLE Beacon (0x5A4E), GNSS Offline Radar.\nPrivasi: Seluruh suara PTT, pesan, dan koordinat tetap di jaringan lokal perangkat Anda tanpa server cloud."
                    android:textColor="@color/ink_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnOpenGithub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_keycap_btn"
                    android:minHeight="48dp"
                    android:text="Buka Repositori GitHub"
                    android:textColor="@color/ink_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="Dibuat di Ponorogo, Jawa Timur, Indonesia ❤️"
                android:textColor="@color/ink_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
