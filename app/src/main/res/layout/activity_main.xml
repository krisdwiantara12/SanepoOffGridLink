<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical">

    <!-- Top Persistent Instrument Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_console"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_radio_ptt"
            app:tint="@color/accent_ink" />

        <LinearLayout
            android:id="@+id/btnEditIdentity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_keycap_btn"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvHeaderCallsign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="UNIT-01 | CH-01"
                android:textColor="@color/ink_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ketuk ubah callsign &amp; saluran"
                android:textColor="@color/ink_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnQuickTorch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_keycap_btn"
            android:contentDescription="Senter cepat"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_torch_morse"
            app:tint="@color/ink_primary" />

        <ImageButton
            android:id="@+id/btnToggleTheme"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_keycap_btn"
            android:contentDescription="@string/desc_theme_toggle"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_theme_contrast"
            app:tint="@color/ink_primary" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/btnOpenAbout"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_keycap_btn"
                android:contentDescription="@string/desc_about"
                android:padding="12dp"
                app:srcCompat="@drawable/ic_about_info"
                app:tint="@color/ink_primary" />

            <View
                android:id="@+id/viewUpdateBadge"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_accent_btn"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle" />

    <!-- Conditional Active SOS Banner -->
    <LinearLayout
        android:id="@+id/bannerSosAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sos_fill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_sos_beacon"
            app:tint="@color/ink_on_sos" />

        <TextView
            android:id="@+id/tvSosBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="SINYAL SOS AKTIF"
            android:textColor="@color/ink_on_sos"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSosBannerAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_keycap_btn"
            android:minHeight="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Cek Radar"
            android:textColor="@color/ink_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Conditional Permission Action Banner -->
    <LinearLayout
        android:id="@+id/bannerPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_well_warn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPermissionInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aktifkan izin Mikrofon, Bluetooth, dan Lokasi agar Walkie-Talkie &amp; Radar bekerja penuh."
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGrantPermissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_accent_btn"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Izinkan"
            android:textColor="@color/ink_on_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Conditional Hardware Radio Toggle Banner (Bluetooth / Location OFF) -->
    <LinearLayout
        android:id="@+id/bannerHardwareToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_well_warn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHardwareToggleInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nyalakan Bluetooth &amp; Lokasi di kedua HP agar bisa langsung tersambung otomatis tanpa Wi-Fi."
            android:textColor="@color/ink_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnEnableBtQuick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_accent_btn"
            android:minHeight="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Nyalakan BT"
            android:textColor="@color/ink_on_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEnableLocQuick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_keycap_btn"
            android:minHeight="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Lokasi"
            android:textColor="@color/ink_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Primary Dynamic Workspace Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- PANEL 1: RADIO PTT -->
        <ScrollView
            android:id="@+id/panelRadio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Frequency & Link Telemetry Console -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_console_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRadioChannelBig"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="SALURAN CH-01"
                            android:textColor="@color/accent_ink"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRadioPeerCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_chip"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="0 Unit Siaga"
                            android:textColor="@color/ink_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRadioFloorState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="SIAGA DENGAR : Tekan dan tahan tombol PTT di bawah untuk berbicara"
                        android:textColor="@color/ink_secondary"
                        android:textSize="13sp" />

                    <com.sanepo.offgrid.ui.WaveformMeterView
                        android:id="@+id/waveformMeter"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tvRadioTransportSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:text="BLE: Siap | P2P: Siaga | LAN: -"
                        android:textColor="@color/ink_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Hero Circular PTT Tactile Dome -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="14dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btnPttDome"
                        android:layout_width="196dp"
                        android:layout_height="196dp"
                        android:background="@drawable/bg_ptt_dome"
                        android:clickable="true"
                        android:contentDescription="Tombol Push To Talk Walkie Talkie"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <ImageView
                                android:id="@+id/ivPttIcon"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_radio_ptt"
                                app:tint="@color/ink_primary" />

                            <TextView
                                android:id="@+id/tvPttDomeLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="sans-serif-condensed"
                                android:gravity="center"
                                android:text="TAHAN BICARA"
                                android:textColor="@color/ink_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPttDomeSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="atau tahan Vol Bawah"
                                android:textColor="@color/ink_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Glove Latch & Channel Stepper Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btnPttLatch"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_keycap_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <ImageView
                                android:id="@+id/ivLatchIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_lock_latch"
                                app:tint="@color/ink_primary" />

                            <TextView
                                android:id="@+id/tvLatchLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Kunci Mic: MATI"
                                android:textColor="@color/ink_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnChannelPrev"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_keycap_btn"
                            android:text="-"
                            android:textColor="@color/ink_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnChannelNext"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_keycap_btn"
                            android:text="+"
                            android:textColor="@color/ink_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Tactical Hold-2-Sec SOS Trigger -->
                <LinearLayout
                    android:id="@+id/btnSosHold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_sos_btn"
                    android:clickable="true"
                    android:contentDescription="@string/desc_sos"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_sos_beacon"
                            app:tint="@color/ink_on_sos" />

                        <TextView
                            android:id="@+id/tvSosBtnLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="TAHAN 2 DETIK : PANCARKAN DARURAT SOS"
                            android:textColor="@color/ink_on_sos"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressSosHold"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/ink_on_sos" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- PANEL 2: COMPASS RADAR -->
        <LinearLayout
            android:id="@+id/panelRadar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Selected Target Numeric HUD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_console_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvRadarTargetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ketuk titik di radar atau daftar di bawah untuk kunci arah"
                    android:textColor="@color/ink_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRadarLocalGps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="Mencari satelit GNSS..."
                    android:textColor="@color/ink_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.sanepo.offgrid.ui.CompassRadarView
                android:id="@+id/compassRadarView"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvRadarEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_console_card"
                android:gravity="center"
                android:padding="14dp"
                android:text="Belum ada unit terdeteksi. Pastikan Bluetooth atau Wi-Fi Direct aktif di kedua perangkat."
                android:textColor="@color/ink_secondary"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRadarPeers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- PANEL 3: OFFLINE CHAT & FIELD PRESETS -->
        <LinearLayout
            android:id="@+id/panelChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChatMessages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="12dp" />

                <LinearLayout
                    android:id="@+id/chatEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="24dp"
                    android:background="@drawable/bg_console_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_chat_packet"
                        app:tint="@color/accent_ink" />

                    <TextView
                        android:id="@+id/tvChatEmptyMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Belum ada pesan di saluran ini. Gunakan tombol cepat di bawah atau ketik pesan baru."
                        android:textColor="@color/ink_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 1-Tap Quick Tactical Replies -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_console"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chipQuickContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp" />
            </HorizontalScrollView>

            <!-- Compose Input Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_console"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageButton
                    android:id="@+id/btnAttachGpsChat"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_keycap_btn"
                    android:contentDescription="Sematkan koordinat GPS saya"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_gps_pin"
                    app:tint="@color/ink_primary" />

                <EditText
                    android:id="@+id/etChatInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_well"
                    android:hint="Tulis pesan offline..."
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/ink_primary"
                    android:textColorHint="@color/ink_secondary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnSendChat"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_accent_btn"
                    android:contentDescription="Kirim pesan"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_send_tx"
                    app:tint="@color/ink_on_accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- PANEL 4: NETWORK, WI-FI DIRECT PAIRING & NODES -->
        <ScrollView
            android:id="@+id/panelNodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Hardware & Local Radio Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_console_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status Jaringan Lokal &amp; P2P"
                        android:textColor="@color/ink_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNodeDiagnostics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="Memuat status..."
                        android:textColor="@color/ink_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCreateP2pHost"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_accent_btn"
                            android:minHeight="48dp"
                            android:text="Buat Host P2P"
                            android:textColor="@color/ink_on_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnScanP2pPeers"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_keycap_btn"
                            android:minHeight="48dp"
                            android:text="Pindai P2P"
                            android:textColor="@color/ink_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDisconnectP2p"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_keycap_btn"
                        android:minHeight="48dp"
                        android:text="Putuskan Grup Wi-Fi Direct"
                        android:textColor="@color/ink_primary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_well_live"
                    android:padding="12dp"
                    android:text="Cara sambung 100% offline: (1) Tanpa Wi-Fi sama sekali: nyalakan Bluetooth &amp; Lokasi di kedua HP untuk koneksi BLE GATT otomatis (chat, radar, SOS, suara PTT 8kHz). (2) Untuk suara HD jarak jauh: nyalakan Wi-Fi lalu tekan Buat Host P2P / gabung Hotspot tanpa kuota."
                    android:textColor="@color/ink_primary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Perangkat Wi-Fi Direct Terlihat"
                    android:textColor="@color/ink_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvP2pEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_console_card"
                    android:padding="12dp"
                    android:text="Belum ada perangkat Wi-Fi Direct terdeteksi. Tekan Pindai P2P untuk mencari."
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvP2pDiscovered"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Semua Unit di Jaringan Mesh (BLE + P2P + LAN)"
                    android:textColor="@color/ink_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMeshEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_console_card"
                    android:padding="12dp"
                    android:text="Belum ada node aktif terdeteksi di sekitar."
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNodesAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle" />

    <!-- Bottom Thumb Navigation Dock (Fixed outside content frame, never hides items) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_console"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/tabRadio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabRadio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_radio_ptt"
                app:tint="@color/ink_primary" />

            <TextView
                android:id="@+id/tvTabRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_radio"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRadar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabRadar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_radar_compass"
                app:tint="@color/ink_primary" />

            <TextView
                android:id="@+id/tvTabRadar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_radar"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabChat"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_chat_packet"
                app:tint="@color/ink_primary" />

            <TextView
                android:id="@+id/tvTabChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_chat"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabNodes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabNodes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_mesh_nodes"
                app:tint="@color/ink_primary" />

            <TextView
                android:id="@+id/tvTabNodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_nodes"
                android:textColor="@color/ink_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
