<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_console"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Identitas Unit &amp; Saluran Radio"
        android:textColor="@color/ink_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Nama Panggilan (Callsign, maks 12 karakter):"
        android:textColor="@color/ink_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etIdentityCallsign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_well"
        android:hint="Misal: KRIS-01"
        android:inputType="textCapCharacters"
        android:maxLength="12"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="@color/ink_primary"
        android:textColorHint="@color/ink_secondary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Nomor Saluran Radio (CH-01 sampai CH-20):"
        android:textColor="@color/ink_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogChDown"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_keycap_btn"
            android:text="-"
            android:textColor="@color/ink_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogChannelVal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="CH-01"
            android:textColor="@color/accent_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDialogChUp"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_keycap_btn"
            android:text="+"
            android:textColor="@color/ink_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
