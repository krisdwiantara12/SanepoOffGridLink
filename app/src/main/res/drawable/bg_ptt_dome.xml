<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_fill" />
            <stroke android:width="4dp" android:color="@color/status_live" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_fill" />
            <stroke android:width="4dp" android:color="@color/ink_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/bg_keycap" />
            <stroke android:width="3.5dp" android:color="@color/accent_ink" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bg_keycap" />
            <stroke android:width="2.5dp" android:color="@color/stroke_instrument" />
        </shape>
    </item>
</selector>
